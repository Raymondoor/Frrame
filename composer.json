{
    "name": "raymondoor/frrame",
    "description": "A PHP application blueprint.",
    "version": "1.0",
    "type": "project",
    "keywords": ["Frrame","framework"],
    "time": "2026-08-08",
    "license": "MIT",
    "authors": [
        {
            "name": "Raymondoor",
            "email": "torhc17311@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.4",
        "vlucas/phpdotenv": "^5.6",
        "raymondoor/migrr": "^0.5.1",
        "monolog/monolog": "^3.10"
    },
    "autoload": {
        "psr-4": {
            "Frrame\\": "app/",
            "Frrame\\Migration\\": "resource/migration/"
        },
        "files": [
            "app/env.php",
            "app/ini.php",
            "app/def.php"
        ]
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "phpstan/phpstan": "^2.2",
        "symfony/var-dumper": "^6.4",
        "fakerphp/faker": "^1.24",
        "guzzlehttp/guzzle": "^8.0"
    },
    "autoload-dev": {
        "psr-4": {
            "Frrame\\Test\\Unit\\": "test/Unit/"
        }
    }
}
